<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header Bar -->
        <com.google.android.material.appbarwidget.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_green"
            android:elevation="4dp"
            app:navigationIcon="@android:drawable/ic_menu_view"
            app:title="@string/app_name"
            app:titleTextColor="@color/white" />

        <!-- Live Indicator Badge -->
        <LinearLayout
            android:id="@+id/liveIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/accent_red_dark"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 LIVE MATCHES"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Competition Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/surface_variant"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:padding="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/all_matches"
                    app:checkedIcon="@android:drawable/ic_menu_view"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/brand_green"
                    app:chipStrokeWidth="2dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/live_matches"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/accent_red" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/favorites"
                    app:chipBackgroundColor="@color/surface"
                    app:chipStrokeColor="@color/accent_gold" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Main Content -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/matchesRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp"
                    tools:listitem="@layout/item_live_match" />

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/no_matches"
                    android:textAppearance="?attr/textAppearanceBodyLarge"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        app:itemIconTint="@color/brand_green"
        app:itemTextColor="@color/text_secondary"
        app:menu="@menu/bottom_nav_menu" />
</FrameLayout>
